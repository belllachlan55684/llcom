<Page
    x:Class="llcom.Pages.SerialPortPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:llcom.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SerialPortPage"
    adonisExtensions:RippleExtension.FadeInDuration="0"
    adonisExtensions:RippleExtension.FadeOutDuration="0"
    d:DesignHeight="480"
    d:DesignWidth="400"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <local:boolVisibe x:Key="boolVisibeConverter" />
    </Page.Resources>
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="35" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Name="serialPortsListComboBox"
                MinWidth="150" />
            <Button
                Name="refreshPortButton"
                Grid.Column="1"
                Margin="5,0,0,0"
                Click="RefreshPortButton_Click"
                Content="{DynamicResource RefreshPortButton}"
                IsEnabled="{Binding ElementName=serialPortsListComboBox, Path=IsEnabled}" />
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,5,0,0" Orientation="Horizontal">
            <ComboBox
                Name="baudRateComboBox"
                Width="100"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipBaudRate}"
                DropDownClosed="BaudRateComboBox_Changed"
                DropDownOpened="BaudRateComboBox_Changed">
                <ComboBoxItem Content="110" />
                <ComboBoxItem Content="330" />
                <ComboBoxItem Content="600" />
                <ComboBoxItem Content="1200" />
                <ComboBoxItem Content="2400" />
                <ComboBoxItem Content="4800" />
                <ComboBoxItem Content="9600" />
                <ComboBoxItem Content="14400" />
                <ComboBoxItem Content="19200" />
                <ComboBoxItem Content="38400" />
                <ComboBoxItem Content="56000" />
                <ComboBoxItem Content="57600" />
                <ComboBoxItem Content="115200" />
                <ComboBoxItem Content="128000" />
                <ComboBoxItem Content="230400" />
                <ComboBoxItem Content="256000" />
                <ComboBoxItem Content="460800" />
                <ComboBoxItem Content="500000" />
                <ComboBoxItem Content="512000" />
                <ComboBoxItem Content="600000" />
                <ComboBoxItem Content="750000" />
                <ComboBoxItem Content="921600" />
                <ComboBoxItem Content="1000000" />
                <ComboBoxItem Content="1500000" />
                <ComboBoxItem Content="2000000" />
                <ComboBoxItem Content="3000000" />
                <ComboBoxItem Content="{DynamicResource OtherRate}" />
            </ComboBox>
            <ComboBox
                Name="dataBitsComboBox"
                Width="50"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipDataBits}"
                SelectionChanged="DataBitsComboBox_SelectionChanged">
                <ComboBoxItem Content="5" Tag="5" />
                <ComboBoxItem Content="6" Tag="6" />
                <ComboBoxItem Content="7" Tag="7" />
                <ComboBoxItem Content="8" Tag="8" />
            </ComboBox>
            <ComboBox
                Name="stopBitComboBox"
                Width="50"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipStopBit}"
                SelectionChanged="StopBitComboBox_SelectionChanged">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="1.5" />
            </ComboBox>
            <ComboBox
                Name="dataCheckComboBox"
                Width="70"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipParity}"
                SelectionChanged="DataCheckComboBox_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource SettingParityNone}" />
                <ComboBoxItem Content="{DynamicResource SettingParityOdd}" />
                <ComboBoxItem Content="{DynamicResource SettingParityEven}" />
                <ComboBoxItem Content="{DynamicResource SettingParityMark}" />
                <ComboBoxItem Content="{DynamicResource SettingParitySpace}" />
            </ComboBox>
            <ComboBox
                Name="encodingComboBox"
                MinWidth="120"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipEncoding}"
                SelectionChanged="EncodingComboBox_SelectionChanged" />
        </WrapPanel>
        <Button
            Name="openClosePortButton"
            Grid.Row="2"
            Margin="0,5,0,0"
            Click="OpenClosePortButton_Click">
            <WrapPanel>
                <TextBlock Name="openClosePortTextBlock" Text="{DynamicResource OpenPort_open}" />
                <TextBlock Text="{DynamicResource OpenPort_port}" />
            </WrapPanel>
        </Button>
        <ScrollViewer Grid.Row="3" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel Margin="10,0,0,0" Orientation="Horizontal">
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingAutoConnect}"
                    ToolTip="{DynamicResource SettingAutoConnectTip}"
                    IsChecked="{Binding autoReconnect}" />
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingShowSendData}"
                    ToolTip="{DynamicResource SettingShowSendDataTip}"
                    IsChecked="{Binding showSend}" />
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingShowRawData}"
                    ToolTip="{DynamicResource SettingShowRawDataTip}"
                    IsChecked="{Binding showSendRaw}" />
                <StackPanel Margin="5" Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="{DynamicResource SettingPackTimeout}"
                        IsChecked="{Binding packEnabled, Mode=TwoWay}"
                        ToolTip="{DynamicResource SettingPackTimeoutTip}" />
                    <TextBox
                        MinWidth="50"
                        Margin="0,0,2,0"
                        Text="{Binding packTimeoutValue, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding packEnabled, Converter={StaticResource boolVisibeConverter}}" />
                    <TextBlock
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Text="{DynamicResource SettingPackTimeoutMs}"
                        Visibility="{Binding packEnabled, Converter={StaticResource boolVisibeConverter}}" />
                </StackPanel>
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingTimeoutMode}"
                    ToolTip="{DynamicResource SettingTimeoutModeTip}"
                    IsChecked="{Binding bitDelay}" />
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingTerminalMode}"
                    ToolTip="{DynamicResource SettingTerminalModeTip}"
                    IsChecked="{Binding terminal}" />
            </WrapPanel>
        </ScrollViewer>
        <TextBox
            Name="toSendDataTextBox"
            Grid.Row="4"
            Margin="2"
            VerticalContentAlignment="Top"
            AcceptsReturn="True"
            FontFamily="Consolas"
            Text="{Binding dataToSend}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            MinHeight="60" />
        <DockPanel Grid.Row="5" Margin="2">
            <Button
                Name="sendDataButton"
                DockPanel.Dock="Right"
                Margin="0,0,0,0"
                Click="SendDataButton_Click"
                Content="{DynamicResource SendDataButton}"
                ToolTip="{DynamicResource SendDataButtonTip}" />
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="RTS" Margin="4,0" VerticalAlignment="Center" IsChecked="{Binding Rts}"/>
                <CheckBox Content="DTR" Margin="4,0" VerticalAlignment="Center" IsChecked="{Binding Dtr}"/>
                <CheckBox Content="{DynamicResource AddExtraEnter}" Margin="4,0" VerticalAlignment="Center"
                          IsChecked="{Binding extraEnter}" ToolTip="{DynamicResource AddExtraEnterTip}"/>
                <CheckBox Content="Hex" Margin="4,0" VerticalAlignment="Center" IsChecked="{Binding hexSend}"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Page>
