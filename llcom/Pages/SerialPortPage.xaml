<Page
    x:Class="llcom.Pages.SerialPortPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:llcom.Pages"
    xmlns:controls="clr-namespace:llcom.View.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SerialPortPage"
    adonisExtensions:RippleExtension.FadeInDuration="0"
    adonisExtensions:RippleExtension.FadeOutDuration="0"
    d:DesignHeight="480"
    d:DesignWidth="400"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <local:boolVisibe x:Key="boolVisibeConverter" />
        <local:showHexFormat x:Key="showHexFormatConverter" />
    </Page.Resources>
    <Grid Name="MainGrid" Margin="2,0,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Name="serialPortsListComboBox"
                MinWidth="150"
                SelectionChanged="SerialPortsListComboBox_SelectionChanged" />
            <Button
                Name="refreshPortButton"
                Grid.Column="1"
                Margin="5,0,0,0"
                Click="RefreshPortButton_Click"
                Content="{DynamicResource RefreshPortButton}"
                IsEnabled="{Binding ElementName=serialPortsListComboBox, Path=IsEnabled}" />
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,5,0,0" Orientation="Horizontal">
            <ComboBox
                Name="baudRateComboBox"
                Width="100"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipBaudRate}"
                DropDownClosed="BaudRateComboBox_Changed"
                DropDownOpened="BaudRateComboBox_Changed">
                <ComboBoxItem Content="110" />
                <ComboBoxItem Content="330" />
                <ComboBoxItem Content="600" />
                <ComboBoxItem Content="1200" />
                <ComboBoxItem Content="2400" />
                <ComboBoxItem Content="4800" />
                <ComboBoxItem Content="9600" />
                <ComboBoxItem Content="14400" />
                <ComboBoxItem Content="19200" />
                <ComboBoxItem Content="38400" />
                <ComboBoxItem Content="56000" />
                <ComboBoxItem Content="57600" />
                <ComboBoxItem Content="115200" />
                <ComboBoxItem Content="128000" />
                <ComboBoxItem Content="230400" />
                <ComboBoxItem Content="256000" />
                <ComboBoxItem Content="460800" />
                <ComboBoxItem Content="500000" />
                <ComboBoxItem Content="512000" />
                <ComboBoxItem Content="600000" />
                <ComboBoxItem Content="750000" />
                <ComboBoxItem Content="921600" />
                <ComboBoxItem Content="1000000" />
                <ComboBoxItem Content="1500000" />
                <ComboBoxItem Content="2000000" />
                <ComboBoxItem Content="3000000" />
                <ComboBoxItem Content="{DynamicResource OtherRate}" />
            </ComboBox>
            <ComboBox
                Name="dataBitsComboBox"
                Width="50"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipDataBits}"
                SelectionChanged="DataBitsComboBox_SelectionChanged">
                <ComboBoxItem Content="5" Tag="5" />
                <ComboBoxItem Content="6" Tag="6" />
                <ComboBoxItem Content="7" Tag="7" />
                <ComboBoxItem Content="8" Tag="8" />
            </ComboBox>
            <ComboBox
                Name="stopBitComboBox"
                Width="50"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipStopBit}"
                SelectionChanged="StopBitComboBox_SelectionChanged">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="1.5" />
            </ComboBox>
            <ComboBox
                Name="dataCheckComboBox"
                Width="70"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipParity}"
                SelectionChanged="DataCheckComboBox_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource SettingParityNone}" />
                <ComboBoxItem Content="{DynamicResource SettingParityOdd}" />
                <ComboBoxItem Content="{DynamicResource SettingParityEven}" />
                <ComboBoxItem Content="{DynamicResource SettingParityMark}" />
                <ComboBoxItem Content="{DynamicResource SettingParitySpace}" />
            </ComboBox>
            <ComboBox
                Name="encodingComboBox"
                MinWidth="120"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TooltipEncoding}"
                SelectionChanged="EncodingComboBox_SelectionChanged" />
        </WrapPanel>
        <WrapPanel Grid.Row="2" Margin="0,5,0,0" Orientation="Horizontal">
            <CheckBox
                Margin="5,0,10,0"
                VerticalAlignment="Center"
                Content="{DynamicResource SettingAutoConnect}"
                ToolTip="{DynamicResource SettingAutoConnectTip}"
                IsChecked="{Binding autoReconnect}" />
        </WrapPanel>
        <Grid Grid.Row="3" Margin="0,5,0,0">
            <Button
                Name="openClosePortButton"
                HorizontalAlignment="Stretch"
                Click="OpenClosePortButton_Click">
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Name="openClosePortTextBlock" Text="{DynamicResource OpenPort_open}" />
                    <TextBlock Text="{DynamicResource OpenPort_port}" />
                </WrapPanel>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="4" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal">
                <controls:ScriptSelectorControl
                    x:Name="recvScriptSelector"
                    InterfaceKey="Serial"
                    IsSendScript="False" />
                <controls:TxRxColorBlocks InterfaceKey="Serial" />
                <StackPanel Margin="5" Orientation="Horizontal" ToolTip="{DynamicResource SettingPackTimeoutTip}">
                    <CheckBox
                        Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Setting.packByTimeout, Mode=TwoWay}" />
                    <TextBlock Margin="0,0,2,0" VerticalAlignment="Center" Text="{DynamicResource SettingPackTimeout}" />
                    <TextBox
                        MinWidth="50"
                        Margin="0,0,2,0"
                        Text="{Binding Setting.packSize, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Text="{DynamicResource SettingPackTimeoutMs}" />
                </StackPanel>
            </WrapPanel>
        </ScrollViewer>
        <TextBox
            Name="toSendDataTextBox"
            Grid.Row="5"
            Margin="0,5,0,0"
            VerticalContentAlignment="Top"
            AcceptsReturn="True"
            FontFamily="Consolas"
            Text="{Binding Display.DataToSend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            MinHeight="60" />
        <DockPanel Grid.Row="6" Margin="0,5,0,0">
            <Button
                Name="sendDataButton"
                DockPanel.Dock="Right"
                Margin="0,0,0,0"
                Click="SendDataButton_Click"
                Content="{DynamicResource SendDataButton}"
                ToolTip="{DynamicResource SendDataButtonTip}" />
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ScriptSelectorControl
                    x:Name="sendScriptSelector"
                    InterfaceKey="Serial"
                    IsSendScript="True" />
                <CheckBox Content="{DynamicResource QuickSendHex}" Margin="4,0" VerticalAlignment="Center" IsChecked="{Binding Display.HexMode, Mode=TwoWay}"/>
                <CheckBox Content="RTS" Margin="4,0" VerticalAlignment="Center" IsChecked="{Binding Setting.Rts}"/>
                <CheckBox Content="DTR" Margin="4,0" VerticalAlignment="Center" IsChecked="{Binding Setting.Dtr}"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Page>
