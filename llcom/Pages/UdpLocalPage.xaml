<Page
    x:Class="llcom.Pages.UdpLocalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:llcom.Pages"
    xmlns:controls="clr-namespace:llcom.View.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UdpLocalPage"
    adonisExtensions:RippleExtension.FadeInDuration="0"
    adonisExtensions:RippleExtension.FadeOutDuration="0"
    d:DesignHeight="480"
    d:DesignWidth="400"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <local:boolVisibe x:Key="boolVisibeConverter" />
        <local:boolNotVisibe x:Key="boolNotVisibeConverter" />
        <local:boolNot x:Key="boolNotConverter" />
        <local:showHexFormat x:Key="showHexFormatConverter" />
    </Page.Resources>
    <Grid Name="MainGrid" Margin="2,0,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel
            x:Name="ConfigWrapPanel"
            Margin="0,5,0,0"
            Orientation="Horizontal">
            <ComboBox
                Name="IpListComboBox"
                MinWidth="150"
                Margin="0,0,5,0"
                IsEditable="True"
                IsEnabled="{Binding IsConnected, Converter={StaticResource boolNotConverter}}" />
            <Button
                x:Name="RefreshIpButton"
                Margin="0,0,5,0"
                Click="RefreshIpButton_Click"
                Content="{DynamicResource RefreshIpList}"
                IsEnabled="{Binding IsConnected, Converter={StaticResource boolNotConverter}}" />
            <TextBox
                x:Name="IpPortTextBox"
                Width="80"
                Margin="0,0,5,0"
                IsEnabled="{Binding ElementName=RefreshIpButton, Path=IsEnabled}"
                Text="{Binding udpServerPort}" />
        </WrapPanel>
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Button
                x:Name="StopListenButton"
                HorizontalAlignment="Stretch"
                Click="StopListenButton_Click"
                Content="{DynamicResource StopListen}"
                Visibility="{Binding IsConnected, Converter={StaticResource boolVisibeConverter}}" />
            <Button
                x:Name="ListenButton"
                HorizontalAlignment="Stretch"
                Click="ListenButton_Click"
                Content="{DynamicResource StartListen}"
                Visibility="{Binding IsConnected, Converter={StaticResource boolNotVisibeConverter}}" />
        </Grid>
        <ScrollViewer x:Name="OptionsScrollViewer" Grid.Row="2" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal">
                <controls:ScriptSelectorControl
                    x:Name="recvScriptSelector"
                    InterfaceKey="UdpLocal"
                    IsSendScript="False" />
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingShowSendData}"
                    ToolTip="{DynamicResource SettingShowSendDataTip}"
                    IsChecked="{Binding ShowSend, Mode=TwoWay}" />
                <controls:TxRxColorBlocks InterfaceKey="UdpLocal" />
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingShowRawData}"
                    ToolTip="{DynamicResource SettingShowRawDataTip}"
                    IsChecked="{Binding ShowSendRaw, Mode=TwoWay}" />
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource ShowHexFormat}"
                    IsChecked="{Binding ShowHexFormat, Converter={StaticResource showHexFormatConverter}, Mode=TwoWay}"
                    IsThreeState="True"
                    ToolTip="{DynamicResource ShowHexFormatTip}" />
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource ShowSymbol}"
                    IsChecked="{Binding EnableSymbol, Mode=TwoWay}"
                    ToolTip="{DynamicResource ShowSymbolTooltip}" />
            </WrapPanel>
        </ScrollViewer>
        <TextBox
            Name="toSendDataTextBox"
            Grid.Row="3"
            Margin="0,5,0,0"
            VerticalContentAlignment="Top"
            AcceptsReturn="True"
            FontFamily="Consolas"
            Text="{Binding DataToSend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            MinHeight="60" />
        <DockPanel Name="SendDockPanel" Grid.Row="4" Margin="0,5,0,0">
            <Button
                Name="SendDataButton"
                DockPanel.Dock="Right"
                Margin="0,0,0,0"
                Click="SendDataButton_Click"
                Content="{DynamicResource NetSendDataButton}"
                IsEnabled="{Binding IsConnected}" />
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ScriptSelectorControl
                    x:Name="sendScriptSelector"
                    InterfaceKey="UdpLocal"
                    IsSendScript="True" />
                <CheckBox Content="{DynamicResource QuickSendHex}" Margin="4,0" VerticalAlignment="Center" IsChecked="{Binding HexMode, Mode=TwoWay}"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Page>
