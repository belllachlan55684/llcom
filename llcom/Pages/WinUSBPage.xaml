<Page
    x:Class="llcom.Pages.WinUSBPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:llcom.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinUSBPage"
    adonisExtensions:RippleExtension.FadeInDuration="0"
    adonisExtensions:RippleExtension.FadeOutDuration="0"
    d:DesignHeight="480"
    d:DesignWidth="400"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <local:boolVisibe x:Key="boolVisibeConverter" />
        <local:boolNotVisibe x:Key="boolNotVisibeConverter" />
        <local:boolNot x:Key="boolNotConverter" />
    </Page.Resources>
    <Grid Name="MainGrid" Margin="2,0,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Name="UsbListComboBox"
                IsEnabled="{Binding IsConnected, Converter={StaticResource boolNotConverter}}"
                SelectionChanged="UsbListComboBox_SelectionChanged" />
            <Button
                x:Name="RefreshUsbButton"
                Grid.Column="1"
                Margin="5,0,0,0"
                Click="RefreshUsbButton_Click"
                Content="{DynamicResource RefreshDevices}"
                IsEnabled="{Binding IsConnected, Converter={StaticResource boolNotConverter}}" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="5,0"
                VerticalAlignment="Center"
                Text="{DynamicResource ReadEndpoint}" />
            <ComboBox
                Name="UsbInComboBox"
                Grid.Column="1"
                IsEnabled="{Binding IsConnected, Converter={StaticResource boolNotConverter}}" />
            <TextBlock
                Grid.Column="2"
                Margin="5,0"
                VerticalAlignment="Center"
                Text="{DynamicResource WriteEndpoint}" />
            <ComboBox
                Name="UsbOutComboBox"
                Grid.Column="3"
                IsEnabled="{Binding IsConnected, Converter={StaticResource boolNotConverter}}" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,5,0,0">
            <Button
                x:Name="ConnectButton"
                HorizontalAlignment="Stretch"
                Click="ConnectButton_Click"
                Content="{DynamicResource OpenPort_open}"
                Visibility="{Binding IsConnected, Converter={StaticResource boolNotVisibeConverter}}" />
            <Button
                x:Name="DisonnectButton"
                HorizontalAlignment="Stretch"
                Click="DisonnectButton_Click"
                Content="{DynamicResource OpenPort_close}"
                Visibility="{Binding IsConnected, Converter={StaticResource boolVisibeConverter}}" />
        </Grid>
        <ScrollViewer x:Name="OptionsScrollViewer" Grid.Row="3" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal">
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingShowSendData}"
                    ToolTip="{DynamicResource SettingShowSendDataTip}"
                    IsChecked="{Binding showSend}" />
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingShowRawData}"
                    ToolTip="{DynamicResource SettingShowRawDataTip}"
                    IsChecked="{Binding showSendRaw}" />
            </WrapPanel>
        </ScrollViewer>
        <TextBox
            Name="toSendDataTextBox"
            Grid.Row="4"
            Margin="0,5,0,0"
            VerticalContentAlignment="Top"
            AcceptsReturn="True"
            FontFamily="Consolas"
            Text="{Binding dataToSend}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            MinHeight="60" />
        <DockPanel Grid.Row="5" Margin="0,5,0,0">
            <Button
                Name="SendDataButton"
                DockPanel.Dock="Right"
                Margin="0,0,0,0"
                Click="SendDataButton_Click"
                Content="{DynamicResource NetSendDataButton}"
                IsEnabled="{Binding IsConnected}" />
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox
                    Content="Hex"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding HexMode}" />
                <ComboBox
                    Name="sendScriptComboBox"
                    MinWidth="120"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    ToolTip="{DynamicResource SendScriptTab}"
                    DropDownOpened="SendScriptComboBox_DropDownOpened"
                    SelectionChanged="SendScriptComboBox_SelectionChanged" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</Page>
