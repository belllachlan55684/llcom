<Page
    x:Class="llcom.Pages.SocketClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:llcom.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SocketClientPage"
    adonisExtensions:RippleExtension.FadeInDuration="0"
    adonisExtensions:RippleExtension.FadeOutDuration="0"
    d:DesignHeight="440"
    d:DesignWidth="400"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <local:boolConnected x:Key="boolConnectedConverter" />
        <local:boolNot x:Key="boolNotConverter" />
        <local:boolVisibe x:Key="boolVisibeConverter" />
        <local:boolNotVisibe x:Key="boolNotVisibeConverter" />
    </Page.Resources>
    <Grid Name="MainGrid" Margin="2,0,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel
            x:Name="ConfigWrapPanel"
            Margin="0,5,0,0"
            Orientation="Horizontal"
            IsEnabled="{Binding Changeable}">
            <ComboBox
                Name="ProtocolTypeComboBox"
                Width="90"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TcpServerProtocol}"
                SelectedIndex="{Binding tcpClientProtocolType}">
                <ComboBoxItem Content="TCP" />
                <ComboBoxItem Content="UDP" />
                <ComboBoxItem Content="TCP SSL" />
            </ComboBox>
            <TextBox
                Name="ServerTextBox"
                MinWidth="150"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TcpServerAddr}"
                Text="{Binding tcpClientServer}" />
            <TextBox
                Name="PortTextBox"
                Width="80"
                Margin="0,0,5,0"
                ToolTip="{DynamicResource TcpServerPort}"
                Text="{Binding tcpClientPort}" />
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,5,0,0" Orientation="Horizontal">
            <CheckBox
                Name="NeedReconnect"
                Margin="5,0,10,0"
                VerticalAlignment="Center"
                Content="{DynamicResource TcpReconnect}"
                IsChecked="{Binding tcpReconnect}" />
            <TextBlock
                Margin="10,0,5,0"
                VerticalAlignment="Center"
                Text="{DynamicResource TcpReconnectInterval}" />
            <TextBox
                x:Name="ReconnectInterval"
                Width="50"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="{Binding tcpReconnectInterval, UpdateSourceTrigger=PropertyChanged}"
                PreviewTextInput="Reconnect_TextInputCheck" />
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="{DynamicResource TcpReconnectIntervalUnit}" />
        </WrapPanel>
        <Grid Grid.Row="2" Margin="0,5,0,0">
            <Button
                Name="ConnectButton"
                HorizontalAlignment="Stretch"
                Click="ConnectButton_Click"
                Content="{DynamicResource SocketConnectButton}"
                Visibility="{Binding NeedDisconnected, Converter={StaticResource boolNotVisibeConverter}}" />
            <Button
                Name="DisconnectButton"
                HorizontalAlignment="Stretch"
                Click="DisconnectButton_Click"
                Content="{DynamicResource SocketDisconnectButton}"
                Visibility="{Binding NeedDisconnected, Converter={StaticResource boolVisibeConverter}}" />
        </Grid>
        <ScrollViewer x:Name="OptionsScrollViewer" Grid.Row="3" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal">
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingShowSendData}"
                    ToolTip="{DynamicResource SettingShowSendDataTip}"
                    IsChecked="{Binding showSend}" />
                <CheckBox
                    Margin="5"
                    Content="{DynamicResource SettingShowRawData}"
                    ToolTip="{DynamicResource SettingShowRawDataTip}"
                    IsChecked="{Binding showSendRaw}" />
            </WrapPanel>
        </ScrollViewer>
        <TextBox
            Name="toSendDataTextBox"
            Grid.Row="4"
            Margin="0,5,0,0"
            VerticalContentAlignment="Top"
            AcceptsReturn="True"
            FontFamily="Consolas"
            Text="{Binding dataToSend}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            MinHeight="60" />
        <DockPanel Grid.Row="5" Margin="0,5,0,0">
            <Button
                Name="SendButton"
                DockPanel.Dock="Right"
                Margin="0,0,0,0"
                Click="SendButton_Click"
                Content="{DynamicResource NetSendDataButton}" />
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox
                    Name="sendScriptComboBox"
                    MinWidth="120"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    ToolTip="{DynamicResource SendScriptTab}"
                    DropDownOpened="SendScriptComboBox_DropDownOpened"
                    SelectionChanged="SendScriptComboBox_SelectionChanged" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</Page>
