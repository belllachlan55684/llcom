<Window x:Class="llcom.View.SystemLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
        Title="{DynamicResource SystemLogTitle}"
        Width="640"
        Height="400"
        MinWidth="400"
        MinHeight="300"
        Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
        Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="ClearButton" Content="{DynamicResource SystemLogClear}" Margin="4" HorizontalAlignment="Left" Click="ClearButton_Click"/>
        <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="4">
            <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                     ItemsSource="{Binding LogLines}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </ScrollViewer>
    </Grid>
</Window>
