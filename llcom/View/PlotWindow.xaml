<Window x:Class="llcom.View.PlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="{DynamicResource PlotHeader}"
        Width="600"
        Height="450"
        MinWidth="400"
        MinHeight="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="{DynamicResource PlotFit}" Margin="2" Click="RefreshButton_Click"/>
            <Button Content="{DynamicResource PlotClear}" Grid.Column="1" Margin="2" Click="ClearButton_Click"/>
            <Button Content="{DynamicResource PlotTheme}" Grid.Column="2" Margin="2" Click="ThemeButton_Click"/>
        </Grid>
        <Grid Grid.Row="1">
            <ScottPlot:WpfPlot Name="Plot" MouseMove="Plot_MouseMove"/>
        </Grid>
    </Grid>
</Window>
