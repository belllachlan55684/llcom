<UserControl
    x:Class="llcom.View.Controls.ScriptSelectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Name="scriptLabelText" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Button
                Name="scriptButton"
            MinWidth="120"
            Margin="4,0"
            VerticalAlignment="Center"
            Click="ScriptButton_Click"
            ToolTip="{DynamicResource ScriptSelectorTooltip}">
            <StackPanel Orientation="Horizontal">
                <fa:FontAwesome Icon="List" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock Name="scriptSummaryText" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        </StackPanel>
        <Popup
            Name="scriptPopup"
            PlacementTarget="{Binding ElementName=scriptButton}"
            Placement="Bottom"
            StaysOpen="False"
            AllowsTransparency="True">
            <Border
                Padding="8"
                MinWidth="320"
                MaxHeight="400"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,4"
                        Text="{DynamicResource ScriptSelectorSelectedLabel}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <ListBox
                            Name="availableListBox"
                            Grid.Column="0"
                            Margin="0,0,4,0"
                            SelectionMode="Single"
                            SelectionChanged="AvailableListBox_SelectionChanged" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="4">
                            <Button
                                Name="addButton"
                                Margin="0,2"
                                Padding="8,4"
                                Content="→"
                                ToolTip="{DynamicResource ScriptSelectorAdd}"
                                Click="AddButton_Click" />
                            <Button
                                Name="removeButton"
                                Margin="0,2"
                                Padding="8,4"
                                Content="←"
                                ToolTip="{DynamicResource ScriptSelectorRemove}"
                                Click="RemoveButton_Click" />
                            <Button
                                Name="upButton"
                                Margin="0,8,0,2"
                                Padding="8,4"
                                Content="↑"
                                ToolTip="{DynamicResource ScriptSelectorMoveUp}"
                                Click="UpButton_Click" />
                            <Button
                                Name="downButton"
                                Margin="0,2"
                                Padding="8,4"
                                Content="↓"
                                ToolTip="{DynamicResource ScriptSelectorMoveDown}"
                                Click="DownButton_Click" />
                        </StackPanel>
                        <ListBox
                            Name="selectedListBox"
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            SelectionMode="Single"
                            SelectionChanged="SelectedListBox_SelectionChanged" />
                    </Grid>
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,4,0,0"
                        FontSize="10"
                        Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                        Opacity="0.8"
                        Text="{DynamicResource ScriptSelectorOrderHint}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
